#!/bin/sh
exec >> /proc/1/fd/1 2>&1
# ===============================================================================
#   K3D Cluster Creation (multi-cluster capable)
#
#   Usage: env-setup <NUM_WORKERS> <CLUSTER_NAME> [INDEX]
#     NUM_WORKERS  number of agent nodes (default 0)
#     CLUSTER_NAME k3d cluster name (default "cluster")
#     INDEX        cluster index; the API is published on port 6443+INDEX
#                  (default 0 -> 6443, so a single-cluster call is unchanged)
#
#   Called once per cluster. After each cluster is created the merged kubeconfig
#   for ALL clusters is (re)written to /home/candidate/.kube/kubeconfig, with one
#   context per cluster (k3d names them "k3d-<CLUSTER_NAME>").
#
#   Examples:
#     env-setup 1 cluster            # single cluster on 6443 (legacy behaviour)
#     env-setup 1 cluster1 0         # cluster1 on 6443
#     env-setup 0 cluster2 1         # cluster2 on 6444
# ===============================================================================

NUM_WORKERS=${1:-0}      # Default to 0 workers if not provided
CLUSTER_NAME=${2:-cluster}
INDEX=${3:-0}            # Cluster index -> API port offset
API_PORT=$((6443 + INDEX))
KUBECONFIG_FILE=/home/candidate/.kube/kubeconfig
# Per-cluster kubeconfig holding ONLY this cluster's context. Multi-cluster
# exams point each server's KUBECONFIG here so the student works with a single
# default context (one host == one cluster == one context, no `use-context`).
PER_CLUSTER_FILE=/home/candidate/.kube/kubeconfig-$CLUSTER_NAME

# Check if k3d is installed, if not install it
if ! command -v k3d &> /dev/null; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') | k3d not found. Attempting installation..."

    # Retry k3d installation
    INSTALL_ATTEMPTS=0
    while [ $INSTALL_ATTEMPTS -lt 99999 ]; do
        INSTALL_ATTEMPTS=$((INSTALL_ATTEMPTS+1))
        echo "$(date '+%Y-%m-%d %H:%M:%S') | Installation attempt $INSTALL_ATTEMPTS"

        # Use the same installation method as in entrypoint.sh
        TAG=v5.8.3 bash /usr/local/bin/k3d-install.sh

        # Check if installation was successful
        if command -v k3d &> /dev/null; then
            echo "$(date '+%Y-%m-%d %H:%M:%S') | k3d successfully installed"
            break
        else
            echo "$(date '+%Y-%m-%d %H:%M:%S') | k3d installation failed. Retrying in 10 seconds..."
            sleep 10
        fi
    done

    # If k3d still not installed, exit with error
    if ! command -v k3d &> /dev/null; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') | ERROR: Failed to install k3d"
        exit 1
    fi
fi

# Generate K3d config for this cluster
cat <<EOF > /tmp/k3d-config.yaml
apiVersion: k3d.io/v1alpha5
kind: Simple
metadata:
  name: $CLUSTER_NAME
servers: 1
agents: $NUM_WORKERS
kubeAPI:
  host: "127.0.0.1"
  hostPort: "$API_PORT"
options:
  k3s:
    extraArgs:
      - arg: "--tls-san=k8s-api-server"
        nodeFilters:
          - server:*
      - arg: "--tls-san=127.0.0.1"
        nodeFilters:
          - server:*
      - arg: "--tls-san=localhost"
        nodeFilters:
          - server:*
EOF

echo "$(date '+%Y-%m-%d %H:%M:%S') | Creating K3d cluster:"
echo "$(date '+%Y-%m-%d %H:%M:%S') | ├── Name:   $CLUSTER_NAME"
echo "$(date '+%Y-%m-%d %H:%M:%S') | ├── API:    k8s-api-server:$API_PORT"
echo "$(date '+%Y-%m-%d %H:%M:%S') | └── Nodes:  $((NUM_WORKERS + 1)) (1 server + $NUM_WORKERS agents)"

# Create k3d cluster (skip if it already exists)
if k3d cluster list | grep -q "^$CLUSTER_NAME "; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') | Cluster '$CLUSTER_NAME' already exists, skipping create"
else
    k3d cluster create --config /tmp/k3d-config.yaml
fi

# ===============================================================================
#   Cluster Readiness Check
# ===============================================================================
CLUSTER_CHECK_COUNT=0
while ! k3d cluster list | grep -q "$CLUSTER_NAME"; do
    CLUSTER_CHECK_COUNT=$((CLUSTER_CHECK_COUNT+1))
    echo "$(date '+%Y-%m-%d %H:%M:%S') | [WAITING] K3d cluster '$CLUSTER_NAME' not ready yet... (attempt $CLUSTER_CHECK_COUNT)"
    sleep 5
done
echo "$(date '+%Y-%m-%d %H:%M:%S') | ✅ K3d cluster '$CLUSTER_NAME' is up and running!"

# ===============================================================================
#   Write the MERGED kubeconfig for every existing cluster.
#   "k3d kubeconfig get --all" emits one context per cluster (k3d-<name>);
#   for a single cluster this is identical to the previous behaviour.
# ===============================================================================
mkdir -p /home/candidate/.kube
k3d kubeconfig get --all > "$KUBECONFIG_FILE"

# Point every server URL at the shared service name (keep each cluster's port)
sed -i 's|server: https://127\.0\.0\.1:\([0-9]*\)|server: https://k8s-api-server:\1|' "$KUBECONFIG_FILE"
sed -i 's|server: https://0\.0\.0\.0:\([0-9]*\)|server: https://k8s-api-server:\1|' "$KUBECONFIG_FILE"

# ===============================================================================
#   Write this cluster's DEDICATED kubeconfig (single context, already selected
#   as current-context by k3d). Servers bound to this cluster export KUBECONFIG
#   to this file, so the student gets exactly one context and never switches.
# ===============================================================================
k3d kubeconfig get "$CLUSTER_NAME" > "$PER_CLUSTER_FILE"
sed -i 's|server: https://127\.0\.0\.1:\([0-9]*\)|server: https://k8s-api-server:\1|' "$PER_CLUSTER_FILE"
sed -i 's|server: https://0\.0\.0\.0:\([0-9]*\)|server: https://k8s-api-server:\1|' "$PER_CLUSTER_FILE"
echo "$(date '+%Y-%m-%d %H:%M:%S') | Per-cluster kubeconfig written: $PER_CLUSTER_FILE"

echo "$(date '+%Y-%m-%d %H:%M:%S') | Kubeconfig updated: $KUBECONFIG_FILE"
echo "Kubeconfig contexts:"
KUBECONFIG="$KUBECONFIG_FILE" k3d kubeconfig get --all >/dev/null 2>&1 || true
grep -E '^\s*name:|current-context:' "$KUBECONFIG_FILE" || true

export KUBECONFIG="$KUBECONFIG_FILE"
echo "$(date '+%Y-%m-%d %H:%M:%S') | Config file setup done for cluster '$CLUSTER_NAME'"
echo "$(date '+%Y-%m-%d %H:%M:%S') | Cluster setup done"

exit 0
